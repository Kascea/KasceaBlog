---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Project from "@components/Project.astro";
import { getProjectData } from "@utils/getRepos";
import { PROJECTS, SITE } from "@config";

const { pinnedRepos, otherRepos, fetchError } = await getProjectData(
  PROJECTS.reposToShow,
  PROJECTS.pinnedRepoNames,
  PROJECTS.commonLanguagesToShow
);

const pinnedFallbackLinks = PROJECTS.pinnedRepoNames.map(name => ({
  name,
  url: `https://github.com/${PROJECTS.githubUsername}/${name}`,
}));
---

<Layout title={`Projects | ${SITE.title}`}>
  <Header activeNav="projects" />
  <Main pageTitle="Projects" pageDesc="My open source work on GitHub.">
    {
      pinnedRepos.length > 0 && (
        <section class="project-section" aria-labelledby="pinned-projects">
          <h2 id="pinned-projects">Pinned Projects</h2>
          <ul>
            {pinnedRepos.map(repo => (
              <Project repo={repo} />
            ))}
          </ul>
        </section>
      )
    }

    {
      pinnedRepos.length === 0 && fetchError && (
        <section class="project-section" aria-labelledby="pinned-projects-fallback">
          <h2 id="pinned-projects-fallback">Pinned Projects</h2>
          <p class="project-empty-state">Live GitHub data is temporarily unavailable.</p>
          <ul class="fallback-links">
            {pinnedFallbackLinks.map(repo => (
              <li>
                <a href={repo.url} class="fallback-link">{repo.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="project-section" aria-labelledby="recent-projects">
      <h2 id="recent-projects">More Projects</h2>
      {
        otherRepos.length > 0 ? (
          <ul>
            {otherRepos.map(repo => (
              <Project repo={repo} />
            ))}
          </ul>
        ) : (
          <p class="project-empty-state">
            {fetchError
              ? "Live GitHub data is temporarily unavailable."
              : "No additional public projects available right now."}
          </p>
        )
      }
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  .project-section {
    @apply mt-8;
  }

  .project-section h2 {
    @apply mb-3 text-xl font-semibold;
  }

  .project-empty-state {
    @apply italic opacity-80;
  }

  .fallback-links {
    @apply mt-2 space-y-1;
  }

  .fallback-link {
    @apply text-skin-accent decoration-dashed underline-offset-4 hover:underline;
  }
</style>
