---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { PROJECTS, SITE, SOCIALS } from "@config";
import socialIcons from "@assets/socialIcons";

const linkedIn = SOCIALS.find(s => s.name === "LinkedIn" && s.active);

const jobs = [
	{
		company: "Medtronic",
		location: "Mounds View, MN",
		summary:
			"Building secure, scalable systems for firmware distribution, device log collection, and identity management.",
		roles: [
			{
				title: "Software Engineer II",
				dates: "Nov 2025 – Present",
			},
		],
	},
	{
		company: "Collins Aerospace",
		location: "Burnsville, MN",
		summary:
			"Built the custom MES and quality software running a $1M-per-day manufacturing plant.",
		roles: [
			{
				title: "Software Engineer I",
				dates: "May 2023 – Oct 2025",
			},
			{
				title: "Software Engineer Co-op",
				dates: "Jan 2022 – May 2023",
			},
		],
	},
];

const education = [
	{
		school: "Georgia Institute of Technology",
		location: "Online",
		degree: "M.S. Computer Science, Computing Systems",
		dates: "Present",
	},
	{
		school: "University of St. Thomas",
		location: "St. Paul, MN",
		degree: "B.S. Computer Science, Minor in Electrical Engineering",
		dates: "Sep 2019 – May 2023",
	},
];
---

<Layout title={`About | ${SITE.title}`}>
	<Header activeNav="about" />
	<main id="main-content">
		<section id="intro">
			<p class="eyebrow location">
				About <span aria-hidden="true">&middot;</span>
				<svg
					viewBox="0 0 88 96"
					stroke-width="5"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path
						d="M1 6.4 5.5 38.4 8.3 54.4 9.4 65.6 9.4 94.4 66.9 94.4 66 88.8 60 83.2 55 78.4 49.5 74.4 50 60.8 55 52.8 55 44 57.2 42.4 69.3 33.6 84.7 23.2 85.8 22.4 80.3 20.8 71.5 19.2 63.8 21.6 51.7 15.2 42.9 13.6 29.7 11.2 27.5 8.8 26 4 26 .5 23.7 .5 23.7 6.4Z"
					/>
				</svg>
				Minnesota
			</p>
			<h1 class="page-title mt-3">Cole Carlson</h1>
			<div class="intro-body">
				<p>
					I'm a software engineer in Minnesota who builds distributed systems.
					I started at Collins Aerospace, building the software that ran a
					$1M-per-day manufacturing plant. Now at Medtronic, I work on the
					systems that deliver firmware to medical devices and collect their
					logs at scale.
				</p>
				<p>
					Outside of work I'm usually at the gym, watching the timberwolves or
					working on home improvement projects.
				</p>
			</div>
		</section>

		<section id="experience" aria-labelledby="experience-title">
			<div class="section-head">
				<h2 id="experience-title" class="section-title">
					Experience &amp; education
				</h2>
				{
					linkedIn && (
						<a
							href={linkedIn.href}
							class="linkedin-link focus-outline"
							target="_blank"
							rel="noopener noreferrer"
							aria-label={linkedIn.linkTitle}
							title={linkedIn.linkTitle}
							set:html={socialIcons.LinkedIn}
						/>
					)
				}
			</div>
			<div class="jobs">
				{
					jobs.map(job => (
						<div class="job">
							<div class="job-header">
								<h3>{job.company}</h3>
								<span class="meta">{job.location}</span>
							</div>
							{job.roles.map(role => (
								<div class="role">
									<div class="role-header">
										<h4>{role.title}</h4>
										<span class="meta font-mono">{role.dates}</span>
									</div>
								</div>
							))}
							<div class="role">
								<p class="summary">{job.summary}</p>
							</div>
						</div>
					))
				}
				{
					education.map(school => (
						<div class="job">
							<div class="job-header">
								<h3>{school.school}</h3>
								<span class="meta">{school.location}</span>
							</div>
							<div class="role">
								<div class="role-header">
									<h4>{school.degree}</h4>
									<span class="meta font-mono">{school.dates}</span>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section id="projects" aria-labelledby="projects-title">
			<div class="section-head">
				<h2 id="projects-title" class="section-title">Projects</h2>
			</div>
			<p class="text-skin-muted">
				Most of what I build lives on GitHub.{" "}
				<a
					href={`https://github.com/${PROJECTS.githubUsername}`}
					class="quiet-link"
				>
					View my projects on GitHub &rarr;
				</a>
			</p>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.intro-body {
		@apply mt-4 max-w-2xl space-y-6 text-lg leading-8;
	}
	.location {
		@apply flex items-center gap-2;
	}
	.location svg {
		@apply h-4 w-4;
		fill: currentColor;
		fill-opacity: 0.2;
		stroke: currentColor;
	}
	section + section {
		@apply mt-12;
	}
	.linkedin-link {
		@apply self-center text-skin-muted transition-colors hover:text-skin-link;
	}
	.linkedin-link :global(svg.icon-tabler) {
		@apply h-5 w-5 scale-100;
	}
	.meta {
		@apply text-sm text-skin-muted;
	}
	.jobs {
		@apply space-y-7;
	}
	.job {
		@apply space-y-2;
	}
	.job-header,
	.role-header {
		@apply flex flex-wrap items-baseline justify-between gap-x-3;
	}
	.job-header h3 {
		@apply text-lg font-semibold;
	}
	.role {
		@apply border-l border-skin-line py-0.5 pl-4;
	}
	.role-header h4 {
		@apply font-medium text-skin-accent;
	}
	.summary {
		@apply mt-0.5 text-sm leading-relaxed text-skin-muted;
	}
</style>
