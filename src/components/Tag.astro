---
export interface Props {
  name: string;
  size?: "sm" | "lg";
}

const { name, size = "sm" } = Astro.props;
---

<li class="inline-block">
  <a
    href={`/tags/${name.toLowerCase()}`}
    class={size === "sm" ? "text-xs" : "text-sm"}
  >
    #{name.toLowerCase()}
  </a>
</li>

<style>
  a {
    @apply inline-block rounded border border-skin-line px-2 py-0.5 font-mono text-skin-muted transition-colors hover:border-skin-accent hover:text-skin-link;
  }
</style>
