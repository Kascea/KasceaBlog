---
import Datetime from "./Datetime.astro";
import type { BlogFrontmatter } from "@content/_schemas";

export interface Props {
  href?: string;
  frontmatter: BlogFrontmatter;
  secHeading?: boolean;
}

const { href, frontmatter, secHeading = true } = Astro.props;
const { title, pubDatetime, description } = frontmatter;
const Heading = secHeading ? "h2" : "h3";
---

<li class="post-row">
  <div class="post-line">
    <Datetime datetime={pubDatetime} className="post-date" />
    <Heading class="post-title">
      <a href={href} class="ink-link">{title}</a>
    </Heading>
  </div>
  {description && <p class="post-desc">{description}</p>}
</li>

<style>
  .post-row {
    @apply border-b border-dotted border-skin-line py-5 first:pt-0 last:border-b-0;
  }
  .post-line {
    @apply flex flex-col gap-x-4 sm:flex-row sm:items-baseline;
  }
  .post-line :global(.post-date) {
    @apply shrink-0 sm:w-[120px];
  }
  .post-title {
    @apply text-base font-medium text-skin-base;
  }
  .post-desc {
    @apply mt-2 max-w-xl text-sm leading-6 text-skin-muted sm:ml-[136px];
  }
</style>
