---
import type { Repo } from "../types";

type Props = {
  repo: Repo;
};

const {
  repo: { name, description, stargazers_count, html_url: link, languageBreakdown = [] },
} = Astro.props;

const visibleLanguages = languageBreakdown.slice(0, 4);
const visibleLanguagePercentage = visibleLanguages.reduce(
  (total, { percentage }) => total + percentage,
  0
);
const otherLanguagePercentage = Math.max(0, 100 - visibleLanguagePercentage);

const languageSegments =
  otherLanguagePercentage > 0
    ? [...visibleLanguages, { language: "Other", percentage: otherLanguagePercentage }]
    : visibleLanguages;
---

<li class="project-row">
  <h3 class="text-base">
    <a href={link} class="project-title ink-link">{name}</a>
  </h3>

  <div class="project-meta">
    <span class="project-stars" aria-label={`${stargazers_count} stars`}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="project-star"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M12 2 L14.37 8.62 L21 9.24 L16.62 13.12 L18 19 L12 16.62 L6 19 L7.38 13.12 L3 9.24 L9.63 8.62 L12 2 Z" />
      </svg>
      {stargazers_count}
    </span>
  </div>

  {description && <p class="project-description">{description}</p>}

  {
    languageSegments.length > 0 ? (
      <p class="language-summary" aria-label={`Language breakdown for ${name}`}>
        {languageSegments.map(({ language, percentage }) => `${language} ${percentage}%`).join(" · ")}
      </p>
    ) : (
      <p class="language-empty">Language data unavailable.</p>
    )
  }
</li>

<style>
  .project-row {
    @apply border-b border-dotted border-skin-line py-5 first:pt-0 last:border-b-0;
  }

  .project-title {
    @apply font-medium text-skin-base;
  }

  .project-meta {
    @apply mt-1 flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1;
  }

  .project-stars {
    @apply inline-flex items-center gap-1 font-mono text-xs text-skin-muted;
  }

  .project-star {
    @apply h-3.5 w-3.5 fill-transparent;
  }

  .project-description {
    @apply mt-2 text-sm leading-6;
  }

  .language-summary {
    @apply mt-1 font-mono text-xs text-skin-muted;
  }

  .language-empty {
    @apply mt-1 text-xs italic text-skin-muted;
  }
</style>
