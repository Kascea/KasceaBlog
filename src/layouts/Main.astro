---
export interface Props {
  pageTitle: string;
  pageDesc?: string;
  eyebrow?: string;
}

const { pageTitle, pageDesc, eyebrow } = Astro.props;
---

<main id="main-content">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h1 class="page-title">{pageTitle}</h1>
  {pageDesc && <p class="page-desc">{pageDesc}</p>}
  <div class="page-body">
    <slot />
  </div>
</main>

<style>
  .page-desc {
    @apply mt-3 max-w-2xl text-lg text-skin-muted;
  }
  .page-body {
    @apply mt-10 border-t border-dotted border-skin-line pt-6;
  }
</style>
