---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime.astro";
import { render, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const { title, author, description, ogImage, pubDatetime, tags } = post.data;

const { Content } = await render(post);

const ogUrl = new URL(ogImage ? ogImage : `${title}.png`, Astro.url.origin)
  .href;
---

<Layout title={title} author={author} description={description ?? undefined} ogImage={ogUrl}>
  <Header activeNav="blog" />
  <main id="main-content">
    <a href="/blog" class="back-link">&larr; All posts</a>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      <div class="post-meta">
        <Datetime datetime={pubDatetime} />
        {tags.length > 0 && (
          <ul class="tags-container">
            {tags.map(tag => <Tag name={slugifyStr(tag)} />)}
          </ul>
        )}
      </div>
    </header>
    <article id="article" role="article" class="prose max-w-none">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .back-link {
    @apply font-mono text-xs uppercase tracking-[0.12em] text-skin-muted hover:text-skin-link;
  }
  .post-header {
    @apply mb-10 mt-6 border-b border-dotted border-skin-line pb-6;
  }
  .post-title {
    @apply text-3xl font-bold leading-tight tracking-[-0.035em] sm:text-4xl;
  }
  .post-desc {
    @apply mt-3 text-lg text-skin-muted;
  }
  .post-meta {
    @apply mt-4 flex flex-wrap items-center gap-x-4 gap-y-2;
  }
  .tags-container {
    @apply flex flex-wrap gap-2;
  }
</style>
